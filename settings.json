{
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(pip:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(cargo:*)",
      "Bash(go:*)",
      "Bash(mvn:*)",
      "Bash(gradle:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(echo:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod 777:*)",
      "Bash(chown:*)",
      "Bash(dd:*)",
      "Bash(format:*)",
      "Bash(fdisk:*)",
      "Bash(mkfs:*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/**)",
      "Edit(~/**)",
      "Write(~/**)",
      "Edit(/etc/**)",
      "Write(/etc/**)",
      "Edit(/System/**)",
      "Write(/System/**)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "MAX_THINKING_TOKENS": "16000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "alwaysThinkingEnabled": true,
  "hasCompletedOnboarding": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/safety-guard.js"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/block-no-verify.js"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/commit-quality.js"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/safety-guard.js"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/suggest-compact.js"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/config-protection.js"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/safety-guard.js"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/suggest-compact.js"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/config-protection.js"
          }
        ]
      },
      {
        "matcher": "Delete",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/safety-guard.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[Agent Check] Verify subagent-type is specified for development roles'"
          }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/phase-controller.js"
          }
        ]
      },
      {
        "matcher": "TeamCreate",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/auto-start-agents.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/edit-accumulator.js"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/console-warn.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/format-typecheck.js",
            "timeout": 300
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/doc-sync-check.js",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "customInstructions": {
    "rageMode": {
      "enabled": true,
      "description": "狂暴模式 - Claude Code 全权接管开发任务",
      "features": {
        "autoGitHubPush": true,
        "autoAgentRestart": true,
        "autoPhaseAdvance": true,
        "safetyGuard": true
      }
    },
    "agentTeamEnforcement": {
      "enabled": true,
      "rules": [
        "All backend development MUST use subagent-type: everything-claude-code:java-reviewer (Java) or everything-claude-code:python-reviewer (Python)",
        "All frontend development MUST use subagent-type: everything-claude-code:typescript-reviewer",
        "All development MUST call Skill tdd first (TDD is mandatory)",
        "All code MUST be reviewed before commit"
      ],
      "requiredAgents": {
        "backend-java": "everything-claude-code:java-reviewer",
        "backend-python": "everything-claude-code:python-reviewer",
        "frontend": "everything-claude-code:typescript-reviewer",
        "architect": "everything-claude-code:architect",
        "qa": "everything-claude-code:tdd-guide"
      }
    }
  },
  "_comment": "Updated 2026-04-11 - v2.3.0: 环境变量 (AUTOCOMPACT/THINKING/SUBAGENT_MODEL)"
}
