{
  "version": "3.0.0",
  "_comment": "Updated 2026-04-28 - v5.0.3 Skill/Team/Audit enforcement + trace-audit.jsonl auto-recording",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/scripts/session-start",
            "description": "注入 using-ce-framework 元技能（入口管理）",
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/safety-guard.js",
            "description": "安全边界检查 - Bash 命令"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/block-no-verify.js",
            "description": "阻止 git push --no-verify / --force 等跳过 hooks 的操作"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/commit-quality.js",
            "description": "提交前: console.log 检测 + 密钥泄露检测"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/safety-guard.js",
            "description": "安全边界检查 - Edit 操作"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/phase-gate-guard.js",
            "description": "阶段门禁前置守卫 - 检查当前阶段是否允许文件操作"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/skill-invocation-guard.js",
            "description": "Skill 调用验证 - 冻结层文档写入前检查对应 Skill marker"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/team-mode-guard.js",
            "description": "Team 模式验证 - Phase 1 冻结层文档写入前检查 Team marker"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/suggest-compact.js",
            "description": "建议压缩上下文（逻辑节点）"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/config-protection.js",
            "description": "阻止修改 linter/formatter/构建配置 + trace-audit.jsonl"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/safety-guard.js",
            "description": "安全边界检查 - Write 操作"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/phase-gate-guard.js",
            "description": "阶段门禁前置守卫 - 检查当前阶段是否允许文件操作"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/skill-invocation-guard.js",
            "description": "Skill 调用验证 - 冻结层文档写入前检查对应 Skill marker"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/team-mode-guard.js",
            "description": "Team 模式验证 - Phase 1 冻结层文档写入前检查 Team marker"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/suggest-compact.js",
            "description": "建议压缩上下文（逻辑节点）"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/config-protection.js",
            "description": "阻止修改 linter/formatter/构建配置 + trace-audit.jsonl"
          }
        ]
      },
      {
        "matcher": "Delete",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/safety-guard.js",
            "description": "安全边界检查 - Delete 操作"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[Agent Check] Verify subagent-type is specified for development roles'",
            "description": "Agent 角色检查"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/auto-trace-recorder.js",
            "description": "自动记录 Agent 调用到 trace-audit.jsonl"
          }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/phase-controller.js",
            "description": "阶段推进检查"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/ac-status-update.js",
            "description": "AC 状态更新（任务完成时检查并更新 AC 状态）"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/gstack-phase-guard.js",
            "description": "GStack Phase 0.5 门禁验证"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/process-trace-check.js --phase=phase1",
            "description": "过程追踪完整性检查（Rule 17）"
          }
        ]
      },
      {
        "matcher": "TeamCreate",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/auto-start-agents.js",
            "description": "自动启动 Agent Team（狂暴模式）"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/team-creation-recorder.js",
            "description": "记录 Team 创建 marker"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/auto-trace-recorder.js",
            "description": "自动记录 TeamCreate 到 trace-audit.jsonl"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/skill-invocation-recorder.js",
            "description": "记录 Skill 调用 marker"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/auto-trace-recorder.js",
            "description": "自动记录 Skill 调用到 trace-audit.jsonl"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/edit-accumulator.js",
            "description": "累积编辑的文件路径，供 Stop 时批量处理"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/console-warn.js",
            "description": "检测编辑文件中的 console.log"
          },
          {
            "type": "command",
            "command": "node hooks/scripts/gstack-output-validator.js",
            "description": "验证 GStack 输出文档完整性"
          }
        ]
      }
    ],
    "Stop": [
      {
        "id": "stop:format-typecheck",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/format-typecheck.js",
            "timeout": 300,
            "description": "批量格式化 + 类型检查所有编辑过的文件（edit-accumulator 模式）"
          }
        ]
      },
      {
        "id": "stop:check-console-log",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/console-warn.js",
            "timeout": 30,
            "description": "批量检查修改文件中的 console.log"
          }
        ]
      },
      {
        "id": "stop:doc-sync-check",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/doc-sync-check.js",
            "timeout": 10,
            "description": "提醒同步文档（对应规则 00_global.md）"
          }
        ]
      },
      {
        "id": "stop:session-evaluate",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/scripts/session-evaluate.js",
            "timeout": 10,
            "description": "评估会话可提取模式（配合 continuous-learning skill）"
          }
        ]
      },
      {
        "id": "stop:gap-detect",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/gap-detector.js --phase=current 2>/dev/null || true",
            "timeout": 15,
            "description": "缺口检测（配合 gap-detector.js）"
          }
        ]
      }
    ],
    "Scheduled": [
      {
        "id": "github-push",
        "interval": 1800000,
        "command": "node hooks/scripts/auto-github-push.js",
        "description": "定时推送 GitHub（每 30 分钟）"
      },
      {
        "id": "agent-health",
        "interval": 300000,
        "command": "node hooks/scripts/agent-health-monitor.js",
        "description": "Agent 健康监控（每 5 分钟）"
      }
    ]
  }
}
