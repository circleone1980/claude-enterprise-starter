{
  "name": "feature-gates",
  "version": "1.1.0",
  "enabled": true,
  "gateMode": "per_feature",
  "features": {},
  "gateConditions": {
    "feature_complete": {
      "description": "Feature 所有 AC 状态为 passed",
      "checkTemplate": "node hooks/scripts/ac-gate-check.js --feat-id={featId} --require-all-passed",
      "checkType": "command_succeeds"
    },
    "test_coverage": {
      "description": "Feature 相关测试覆盖率 > 80%",
      "checkTemplate": "node hooks/scripts/ac-gate-check.js --feat-id={featId} --check-coverage",
      "checkType": "command_succeeds"
    },
    "ac_verified": {
      "description": "每个 AC 都有对应的已通过测试",
      "checkTemplate": "node hooks/scripts/ac-gate-check.js --feat-id={featId} --check-ac-tests",
      "checkType": "command_succeeds"
    }
  },
  "gstack": {
    "enabled": false,
    "description": "GStack 产品设计层 (Phase 0.5)",
    "toggleScript": "scripts/gstack-toggle.js",
    "requiredOutputs": {
      "phase0.5a": ["workspace/docs/design/DESIGN.md", "workspace/docs/design/OFFICE_HOURS.md"],
      "phase0.5b": ["workspace/docs/design/IMPLEMENTATION_PLAN.md"]
    }
  },
  "phaseIntegration": {
    "phase2_to_phase3_ac_condition": {
      "description": "所有 Feature AC 通过",
      "check": "node hooks/scripts/ac-gate-check.js --all-features-passed",
      "checkType": "command_succeeds"
    }
  },
  "_comment": "v1.1.0 - Added gstack feature toggle"
}