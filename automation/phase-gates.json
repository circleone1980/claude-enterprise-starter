{
  "name": "phase-gates",
  "version": "3.1.0",
  "enabled": true,
  "gates": {
    "phase0_brainstorm_complete": {
      "conditions": [
        {
          "description": "头脑风暴笔记已生成",
          "check": "node -e \"const d='docs/brainstorms/';const f=require('fs');if(!f.existsSync(d)){process.exit(1)}process.exit(f.readdirSync(d).some(x=>x.endsWith('.md'))?0:1)\"",
          "checkType": "dir_has_md"
        },
        {
          "description": "过程追踪记录已创建",
          "check": "node -e \"require('fs').existsSync('docs/process-trace/phase0/')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "用户已确认方向",
          "check": "node -e \"require('fs').existsSync('.user-confirmed')||process.exit(1)\"",
          "checkType": "file_exists"
        }
      ],
      "autoAdvance": false,
      "requireApproval": true
    },
    "phase0_to_phase0.5": {
      "conditions": [
        {
          "description": "GStack 已启用",
          "check": "node -e \"try{const c=require('./automation/agent-orchestration.json');process.exit(c.gstackConfig&&c.gstackConfig.enabled?0:1)}catch(e){process.exit(1)}\"",
          "checkType": "command_succeeds"
        }
      ],
      "autoAdvance": true,
      "gatedByFeature": "gstack.enabled"
    },
    "phase0.5_to_phase1": {
      "conditions": [
        {
          "description": "DESIGN.md 已生成",
          "check": "node -e \"require('fs').existsSync('workspace/docs/design/DESIGN.md')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "IMPLEMENTATION_PLAN.md 已生成",
          "check": "node -e \"require('fs').existsSync('workspace/docs/design/IMPLEMENTATION_PLAN.md')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "OFFICE_HOURS.md 已生成",
          "check": "node -e \"require('fs').existsSync('workspace/docs/design/OFFICE_HOURS.md')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "设计审查评分 >= 7.0",
          "check": "node -e \"try{const p=require('./workspace/docs/design/IMPLEMENTATION_PLAN.json');process.exit(p&&p.overallScore>=7.0?0:1)}catch(e){process.exit(1)}\"",
          "checkType": "command_succeeds"
        }
      ],
      "autoAdvance": true,
      "gatedByFeature": "gstack.enabled"
    },
    "phase0_to_phase1": {
      "conditions": [
        {
          "description": "目录结构已创建",
          "check": "node -e \"const f=require('fs');process.exit(f.existsSync('src')||f.existsSync('docs')?0:1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "开发环境已配置",
          "check": "node -e \"const f=require('fs');process.exit(f.existsSync('package.json')||f.existsSync('pom.xml')||f.existsSync('pyproject.toml')?0:1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "GitHub 仓库已创建",
          "check": "node -e \"require('child_process').execSync('git remote').toString().includes('origin')||process.exit(1)\"",
          "checkType": "command_succeeds"
        }
      ],
      "autoAdvance": true
    },
    "phase1_to_phase2": {
      "conditions": [
        {
          "description": "PRD 文档已完成",
          "check": "node -e \"require('fs').existsSync('docs/requirements/PRD.md')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "用户故事文档已完成",
          "check": "node -e \"require('fs').existsSync('docs/requirements/user-stories.md')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "验收标准文档已完成",
          "check": "node -e \"require('fs').existsSync('docs/requirements/acceptance-criteria.md')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "系统架构设计文档已完成",
          "check": "node -e \"require('fs').existsSync('docs/design/01_系统架构设计.md')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "数据库设计文档已完成",
          "check": "node -e \"require('fs').existsSync('docs/design/02_数据库设计.md')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "API 接口设计文档已完成",
          "check": "node -e \"require('fs').existsSync('docs/design/03_API接口设计.md')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "UI 设计规范文档已完成",
          "check": "node -e \"require('fs').existsSync('docs/design/04_UI设计规范.md')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "Architect 已审查所有设计文档",
          "check": "node -e \"require('fs').existsSync('docs/design/.architect-review-approved')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "冻结层文档已锁定",
          "check": "node -e \"require('fs').existsSync('docs/requirements/.frozen')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "任务已分配",
          "check": "node -e \"require('fs').existsSync('docs/requirements/sprint-plan.md')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "过程追踪记录已创建",
          "check": "node -e \"require('fs').existsSync('docs/process-trace/phase1/')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "过程追踪内容完整",
          "check": "node hooks/scripts/process-trace-check.js --phase=phase1",
          "checkType": "command_succeeds"
        },
        {
          "description": "对抗审查已执行",
          "check": "node -e \"const f=require('fs');const d='docs/reviews/';if(!f.existsSync(d)){process.exit(1)}const files=f.readdirSync(d).filter(f=>f.endsWith('.md'));process.exit(files.length>=1?0:1)\"",
          "checkType": "command_succeeds"
        }
      ],
      "autoAdvance": true,
      "requireApproval": false
    },
    "phase2_to_phase3": {
      "conditions": [
        {
          "description": "所有代码已实现",
          "check": "node -e \"require('fs').existsSync('.claude/logs/.phase2-code-complete')||require('fs').existsSync('.phase2-code-complete')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "单元测试覆盖率 > 80%",
          "check": "node -e \"require('fs').existsSync('.claude/logs/.phase2-coverage-pass')||require('fs').existsSync('.phase2-coverage-pass')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "所有单元测试通过",
          "check": "node -e \"require('fs').existsSync('.claude/logs/.phase2-tests-pass')||require('fs').existsSync('.phase2-tests-pass')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "代码审查已完成",
          "check": "node -e \"require('fs').existsSync('.claude/logs/.phase2-review-pass')||require('fs').existsSync('.phase2-review-pass')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "所有 Feature AC 验收通过",
          "check": "node hooks/scripts/ac-gate-check.js --all-features-passed",
          "checkType": "command_succeeds"
        },
        {
          "description": "开发阶段过程追踪已创建",
          "check": "node -e \"require('fs').existsSync('docs/process-trace/phase2/')||process.exit(1)\"",
          "checkType": "file_exists"
        }
      ],
      "autoAdvance": true,
      "requireApproval": false
    },
    "phase3_to_phase4": {
      "conditions": [
        {
          "description": "所有测试用例通过",
          "check": "node -e \"require('fs').existsSync('.claude/logs/.phase3-tests-pass')||require('fs').existsSync('.phase3-tests-pass')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "集成测试通过",
          "check": "node -e \"require('fs').existsSync('.claude/logs/.phase3-integration-pass')||require('fs').existsSync('.phase3-integration-pass')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "E2E 测试通过",
          "check": "node -e \"require('fs').existsSync('.claude/logs/.phase3-e2e-pass')||require('fs').existsSync('.phase3-e2e-pass')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "测试报告已输出",
          "check": "node -e \"require('fs').existsSync('docs/test/test-report.md')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "所有 Bug 已修复并验证",
          "check": "node -e \"require('fs').existsSync('.claude/logs/.phase3-bugs-fixed')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "ADR 审查已完成（如有架构变更）",
          "check": "node -e \"const f=require('fs');const hasArchChanges=f.existsSync('.claude/logs/.phase3-arch-changes');if(!hasArchChanges){process.exit(0)}process.exit(f.existsSync('.claude/logs/.phase3-adr-reviewed')?0:1)\"",
          "checkType": "command_succeeds"
        }
      ],
      "autoAdvance": true,
      "requireApproval": false
    },
    "phase4_to_phase5": {
      "conditions": [
        {
          "description": "产品体验测试已完成",
          "check": "node -e \"require('fs').existsSync('.claude/logs/.phase4-ux-complete')||require('fs').existsSync('.phase4-ux-complete')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "体验报告已输出",
          "check": "node -e \"require('fs').existsSync('docs/test/ux-report.md')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "关键体验问题已修复",
          "check": "node -e \"require('fs').existsSync('.claude/logs/.phase4-ux-fixes-complete')||require('fs').existsSync('.phase4-ux-fixes-complete')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "UX 修复闭环完成（所有 UX 问题已解决并验证）",
          "check": "node -e \"require('fs').existsSync('.claude/logs/.phase4-ux-loop-pass')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "ADR 审查已完成（如有架构变更）",
          "check": "node -e \"const f=require('fs');const hasArchChanges=f.existsSync('.claude/logs/.phase4-arch-changes');if(!hasArchChanges){process.exit(0)}process.exit(f.existsSync('.claude/logs/.phase4-adr-reviewed')?0:1)\"",
          "checkType": "command_succeeds"
        }
      ],
      "autoAdvance": true,
      "requireApproval": false
    },
    "phase5_to_complete": {
      "conditions": [
        {
          "description": "部署成功",
          "check": "node -e \"require('fs').existsSync('.claude/logs/.phase5-deploy-success')||require('fs').existsSync('.phase5-deploy-success')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "健康检查通过",
          "check": "node -e \"require('fs').existsSync('.claude/logs/.phase5-health-check-pass')||require('fs').existsSync('.phase5-health-check-pass')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "文档已更新",
          "check": "node -e \"require('fs').existsSync('.claude/logs/.phase5-docs-updated')||require('fs').existsSync('.phase5-docs-updated')||process.exit(1)\"",
          "checkType": "file_exists"
        },
        {
          "description": "代码已推送到 GitHub",
          "check": "node -e \"const r=require('child_process').execSync('git log origin/main..HEAD --oneline').toString().trim();process.exit(r.length===0?0:1)\"",
          "checkType": "command_succeeds",
          "cwd": "project_root"
        }
      ],
      "autoAdvance": true,
      "requireApproval": false,
      "notifyOnComplete": true
    }
  },
  "failureHandling": {
    "retryCount": 3,
    "retryDelay": 60000,
    "escalateOnFailure": true,
    "notificationChannel": "console"
  },
  "_comment": "v3.1.0 - Phase 3/4 expanded gates: bug-fix loop + UX-fix loop + ADR conditional checks"
}