{
  "name": "rage-mode",
  "version": "3.1.0",
  "enabled": true,
  "description": "狂暴模式 - Claude Code 全权接管开发任务",
  "features": {
    "autoGitHubPush": {
      "enabled": true,
      "interval": 1800000,
      "onPhaseComplete": true
    },
    "autoAgentRestart": {
      "enabled": true,
      "checkInterval": 300000,
      "maxRetries": 3,
      "restartDelay": 10000
    },
    "autoPhaseAdvance": {
      "enabled": true,
      "requireQualityGates": true
    },
    "safetyGuard": {
      "enabled": true,
      "strictBoundaries": true
    }
  },
  "phases": [
    {
      "id": 0,
      "name": "产品构思与初始化",
      "autoAdvance": false,
      "requiredAgents": ["Brainstormer"],
      "qualityGates": ["头脑风暴笔记已生成", "用户已确认方向"],
      "actions": ["与用户进行产品构思讨论", "探索技术路线", "收敛需求方向", "初始化目录结构"]
    },
    {
      "id": "0.5a",
      "name": "产品设计 - 构思",
      "autoAdvance": true,
      "requiredAgents": ["Product-Designer"],
      "qualityGates": ["DESIGN.md 已生成", "HTML 原型已生成"],
      "gstackOnly": true
    },
    {
      "id": "0.5b",
      "name": "产品设计 - 规划审查",
      "autoAdvance": true,
      "requiredAgents": ["Design-Reviewer"],
      "qualityGates": ["IMPLEMENTATION_PLAN.md 已生成", "各维度评分 >= 7.0"],
      "gstackOnly": true
    },
    {
      "id": 1,
      "name": "需求分析",
      "autoAdvance": true,
      "requiredAgents": ["PM", "PO", "Architect"],
      "qualityGates": [
        "PRD 完成",
        "用户故事完成",
        "验收标准完成",
        "架构设计完成",
        "数据库设计完成",
        "API 接口设计完成",
        "UI 设计规范完成",
        "冻结层文档已审查",
        "冻结层文档已锁定"
      ]
    },
    {
      "id": 2,
      "name": "开发实现",
      "autoAdvance": true,
      "requiredAgents": ["UI-Designer", "Frontend", "Backend-Python"],
      "qualityGates": ["代码实现完成", "单元测试通过", "代码审查通过"]
    },
    {
      "id": 3,
      "name": "测试验证",
      "autoAdvance": true,
      "requiredAgents": ["QA", "Frontend", "Backend-Python", "Architect", "PM"],
      "qualityGates": ["测试覆盖率 >80%", "所有测试通过", "Bug 修复闭环完成", "ADR 审查完成（如有架构变更）"]
    },
    {
      "id": 4,
      "name": "产品体验",
      "autoAdvance": true,
      "requiredAgents": ["产品体验师", "UI-Designer", "Frontend", "Backend-Python", "Architect", "PM"],
      "qualityGates": ["体验测试完成", "体验报告输出", "UX 问题修复闭环完成", "ADR 审查完成（如有架构变更）"]
    },
    {
      "id": 5,
      "name": "部署发布",
      "autoAdvance": true,
      "requiredAgents": ["DevOps"],
      "qualityGates": ["部署成功", "健康检查通过"]
    }
  ],
  "ganPhase": {
    "id": "gan",
    "name": "GAN Harness",
    "autoAdvance": false,
    "requiredAgents": ["GAN-Planner", "GAN-Generator", "GAN-Evaluator"],
    "qualityGates": ["评分 >= threshold"],
    "config": {
      "threshold": 7.0,
      "maxIterations": 3,
      "outputDir": "output"
    }
  },
  "notifications": {
    "onPhaseComplete": true,
    "onAgentFailure": true,
    "onAllComplete": true
  },
  "_comment": "v3.1.0 - Phase 3/4 expanded to multi-role Teams for test-fix and UX-fix loops"
}