{
  "name": "claude-enterprise-starter",
  "version": "5.1.0",
  "private": true,
  "description": "Enterprise-grade Claude Code configuration template",
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "test:static": "node --test test/static/**/*.test.js",
    "test:hooks": "node --test test/hooks/**/*.test.js",
    "test:integration": "node --test test/integration/**/*.test.js",
    "validate": "node scripts/validate-config.js",
    "check-all": "node scripts/validate-config.js && node --test test/**/*.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
